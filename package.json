{
  "name": "reviewctl",
  "version": "0.1.2",
  "description": "Evidence-driven adversarial reviews across AI coding agents.",
  "type": "module",
  "bin": {
    "reviewctl": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "eval",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.js",
    "eval": "node eval/run.mjs --results eval/fixtures/baseline-results.json",
    "eval:live": "npm run build && node eval/run.mjs --live",
    "check": "npm test",
    "prepack": "npm run check"
  },
  "keywords": [
    "ai",
    "code-review",
    "codex",
    "claude",
    "adversarial-review",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
